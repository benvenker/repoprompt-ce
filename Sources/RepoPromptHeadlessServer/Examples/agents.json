{
  "claude": {
    "argv": [
      "claude",
      "-p",
      "{PROMPT}",
      "--mcp-config",
      "{MCP_CONFIG}",
      "--strict-mcp-config",
      "--permission-mode",
      "bypassPermissions"
    ],
    "promptVia": "argv"
  },
  "pi": {
    "argv": ["pi", "--mcp-config", "{MCP_CONFIG}", "{PROMPT_FILE}"],
    "promptVia": "file"
  }
}
