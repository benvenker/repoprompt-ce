# Copy to /etc/rpce-headless/rpce-headless.env and adjust for the host.
#
# Deterministic tools do not require an oracle key. oracle_send,
# context-build --response-type question|plan, and context_builder
# response_type=question|plan|review do.

RPCE_ORACLE_BASE_URL=https://openrouter.ai/api/v1
RPCE_ORACLE_MODEL=openrouter/auto

# Prefer RPCE_ORACLE_API_KEY for this service. OPENROUTER_API_KEY is also
# accepted for local shell usage.
RPCE_ORACLE_API_KEY=

# Optional state/cache locations. systemd can also set these via StateDirectory
# and CacheDirectory if you prefer service-managed paths.
# Oracle state lands under $XDG_STATE_HOME/rpce-headless.
XDG_STATE_HOME=/var/lib/rpce-headless/state
XDG_CACHE_HOME=/var/cache/rpce-headless

# Required only for `serve --socket --expose-all-tools` (full-tool socket).
# Generate with: openssl rand -hex 32
# RPCE_SOCKET_AUTH_TOKEN=

# --- Agent runner (agent_run/agent_manage) ---
# Agent template file; copy Examples/agents.json here and edit for the host.
# RPCE_AGENT_CONFIG=/etc/rpce-headless/agents.json
# Default agent name for agent_run.start when model_id is omitted.
# RPCE_AGENT_RUN_DEFAULT_AGENT=claude
# Directory for per-session restricted MCP socket files.
# RPCE_AGENT_SOCKET_DIRECTORY=/run/rpce-headless
# Captured stdout/stderr byte budget per agent session.
# RPCE_AGENT_OUTPUT_CAPTURE_LIMIT_BYTES=1000000

# --- Context builder ---
# Discovery agent name used by the context_builder MCP tool. For real Codex,
# Claude Code, Gemini, or similar MCP-capable CLIs, prefer async op=start,
# op=poll/op=wait, op=get_result, and op=cleanup instead of lowering budgets
# to fit one client deadline.
# RPCE_CONTEXT_BUILDER_AGENT=claude
# Agent template file for context_builder; defaults to RPCE_AGENT_CONFIG.
# RPCE_CONTEXT_BUILDER_AGENT_CONFIG=/etc/rpce-headless/agents.json
# Discovery-agent deadline in seconds for context_builder start/one-shot runs.
# This is not the same as op=wait timeout, which only caps a polling request.
# RPCE_CONTEXT_BUILDER_TIMEOUT_SECONDS=120
# Token budget for discovery context packing. Normal real-agent budgets are
# 120000-160000; clarify defaults to 160000 and oracle-backed modes default
# to 120000 when this is unset.
# RPCE_CONTEXT_BUILDER_TOKEN_BUDGET=160000
# Optional fixed socket path for context builder discovery.
# RPCE_CONTEXT_BUILDER_SOCKET_PATH=/run/rpce-headless/context-builder.sock
# Captured stdout/stderr byte budget for context_builder discovery agents.
# Falls back to RPCE_AGENT_OUTPUT_CAPTURE_LIMIT_BYTES when unset.
# RPCE_CONTEXT_BUILDER_OUTPUT_CAPTURE_LIMIT_BYTES=1000000
